# Copy to .env and fill in. Never commit .env.

# SQLite file. Relative paths resolve from the project root.
DATABASE_PATH=data/rfx.db

# Currency every NormalizedQuote is expressed in (ex-tax).
BASE_CURRENCY=INR

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Add when extraction features are built:
# ANTHROPIC_API_KEY=
